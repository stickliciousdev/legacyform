# Copy this to .streamlit/secrets.toml for local testing.
# On Streamlit Community Cloud: App settings > Secrets > paste the same content.
#
# Get the URL from Supabase: Project Settings > Database > Connection string >
# "Session pooler" (IPv4-compatible, works from anywhere) > URI tab.
# It looks like: postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres
# Replace [YOUR-PASSWORD] with your actual database password, and change the
# scheme from postgresql:// to postgresql+psycopg2:// for SQLAlchemy.

[connections.supabase_db]
url = "postgresql+psycopg2://postgres.xxxxxxxx:YOUR-PASSWORD@aws-x-xx-xxxx-x.pooler.supabase.com:5432/postgres"
